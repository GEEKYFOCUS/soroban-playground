{
  "name": "soroban-playground",
  "version": "1.0.0",
  "description": "Browser-based IDE for compiling and deploying Soroban Smart Contracts to Stellar Testnet",
  "author": "Ayomide (Maintainer) & Open Source Contributors",
  "license": "MIT",
  "private": true,
  "overrides": {
    "graphql": "^16.13.2",
    "tar": "^7.5.19",
    "node-gyp": {
      "tar": "^7.5.19"
    },
    "cacache": {
      "tar": "^7.5.19"
    },
    "dompurify": "^3.4.11",
    "@tootallnate/once": "^3.0.1",
    "monaco-editor": "0.53.0",
    "brace-expansion": "^1.1.18"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "node init && npm run start --workspace=backend",
    "dev": "node init && npm run dev --workspaces --if-present",
    "build": "node init && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:check": "npm run lint:check --workspaces --if-present"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1"
  }
}
